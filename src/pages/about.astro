---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import { SITE } from '@/site.config';

const tools = [
  'Verilog',
  'SolidWorks',
  'Siemens NX CAM',
  'C++',
  'Docker/Portainer',
  'MATLAB',
  'Proxmox VE',
  'Linux'
];
---

<BaseLayout title="About" description={`A bit about ${SITE.name} and their engineering background.`}>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <p class="text-ink-soft mb-6 font-mono text-xs tracking-[0.2em] uppercase">About</p>

    <h1 class="font-display text-ink max-w-xl text-3xl font-medium sm:text-4xl">
      Bridging mechanical intuition with digital hardware.
    </h1>

    <div class="prose prose-sm sm:prose-base mt-8 max-w-xl">
      <p>
        I am a Computer Engineering student at Northwestern University driven by a fascination with how systems work--from the bare metal to the application layer
      </p>
      <p>
        My engineering philosphy is rooted in hands-on mechanics. The same troubleshooting mindset I use to 
        machine an aluminum differential housing or tune a marine engine directly translates into 
        diagonising timing bottlenecks in complex systems or optimizing ZFS pools in a 
        Proxox cluser.
      </p>
      <p>
        By combining a rigorous academic foundation in digital logic and embedded systems with a deep familiarity with the 
        Linux development enviornment, I build robust, full-stack solutions. Whether I am routing physical brake lines on the Baja
        car or configuring a remote VPN tunnel, I am passionate about bridging the gap between
        hardware constraints and scalable software architectures.
      </p>
      <p>
        When I am not in the machine shop or my homelab, I am likely working on something mechanical in my garage, going on a run or heading to the gym, 
        or just stuck reading a really good book.
      </p>
    </div>

    <div class="mt-10">
      <p class="text-ink-soft mb-3 font-mono text-xs tracking-[0.2em] uppercase">Tools</p>
      <ul class="flex flex-wrap gap-2">
        {
          tools.map((tool) => (
            <li class="border-line text-ink-soft rounded-full border px-3 py-1 font-mono text-xs">
              {tool}
            </li>
          ))
        }
      </ul>
    </div>

    <Button href={`mailto:${SITE.email}`} class="mt-10">Get in touch</Button>
  </section>
</BaseLayout>
